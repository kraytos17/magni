target
*.db
*.bin
*.wal
*.db-wal
__pycache__

# AFL++ fuzzing seeds (generated; single source of truth is the generator
# script in fuzz/generators/)
fuzz/corpus/*
!fuzz/corpus/promoted_seeds.py
fuzz/corpus_exec/*
!fuzz/corpus_exec/promoted_seeds.py

# AFL++ runtime outputs (generated)
fuzz/corpus_grown/
fuzz/afl-output/
fuzz/afl-exec-output/
