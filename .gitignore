build
*.db
*.bin
*.wal
*.db-wal
__pycache__

# AFL++ fuzzing seeds (generated; single source of truth is the generator script)
fuzz/corpus/*
!fuzz/corpus/gen_corpus.py
!fuzz/corpus/promoted_seeds.py
fuzz/corpus_exec/*
!fuzz/corpus_exec/gen_exec_corpus.py
!fuzz/corpus_exec/promoted_seeds.py

# AFL++ runtime outputs (generated)
fuzz/corpus_grown/
fuzz/afl-output/
fuzz/afl-exec-output/
fuzz/build/

# Fuzz target binaries (built via magni.py build --asan/--cov/--exec)
fuzz/fuzz_target
fuzz/fuzz_target_cov
fuzz/fuzz_target_cmplog
fuzz/fuzz_target_laf
fuzz/fuzz_exec_target
