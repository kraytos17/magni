target
*.db
*.bin
*.wal
*.db-wal
__pycache__

# AFL++ fuzzing seeds (generated; single source of truth is the generator
# script in fuzz/generators/)
fuzz/corpus/*
!fuzz/corpus/promoted_seeds.py
# Exec corpus dir holds only generated output now; its promoted table lives
# in fuzz/generators/promoted_exec_seeds.py (created by `corpus generate --exec`)
fuzz/corpus_exec/

# AFL++ runtime outputs (generated)
fuzz/corpus_grown/
fuzz/afl-output/
fuzz/afl-exec-output/
